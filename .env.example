# Supabase — create project at supabase.com, copy from Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Paddle — create product at paddle.com, copy the price/product ID
EXPO_PUBLIC_PADDLE_PRODUCT_ID=pri_your_product_id_here

# Paddle webhook secret — set in Paddle Dashboard → Notifications → Webhooks
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret-here
